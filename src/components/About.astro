      </div>
    </div>

    <!-- Timeline (Experience & Education) -->
    <div class="reveal delay-2">
      <div class="eyebrow">Experience & Education</div>
      <div class="timeline">
        <!-- Job 1 -->
        <div class="timeline-item">
          <div class="timeline-date">May 2025 — Feb 2026</div>
          <h3 class="timeline-title">Senior Web Developer</h3>
          <div class="timeline-subtitle">Cielsko Ecommerce LLP · Remote</div>
          <p class="timeline-description">
            Developed and maintained web products and WordPress-based e-commerce solutions. Collaborated with
            cross-functional teams on product features and deployment workflows.
          </p>
        </div>

        <!-- Job 2 -->
        <div class="timeline-item">
          <div class="timeline-date">Ongoing</div>
          <h3 class="timeline-title">Freelance & Contract Work</h3>
          <div class="timeline-subtitle">Independent</div>
          <p class="timeline-description">
            Actively working on multiple contract projects — web development, app development, and cloud deployments
            for various clients.
          </p>
        </div>

        <!-- Education -->
        <div class="timeline-item">
          <div class="timeline-date">2023 — 2027</div>
          <h3 class="timeline-title">B.Tech in CS & Engineering</h3>
          <div class="timeline-subtitle">M.G.M's Jawaharlal Nehru Engineering College</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--page-pad);
  }

  .section {
    padding: 8rem var(--page-pad);
  }

  .eyebrow {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--muted);
    margin-bottom: 1.5rem;
    font-weight: 600;
  }

  .section-title {
    font-size: clamp(2.25rem, 8vw, 4.5rem);
    margin-bottom: 1.5rem;
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .lead-text {
    font-size: clamp(1.05rem, 2.5vw, 1.15rem);
    margin-bottom: 1.5rem;
  }

  .lead-text.fg {
    color: var(--fg);
  }

  .lead-text.muted {
    color: var(--muted);
  }

  .about-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }

  /* Skills */
  .skills-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .skill-pill {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.6rem 1.2rem;
    border-radius: 999px;
    font-size: 0.9rem;
    color: var(--fg);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  
  .skill-pill:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }

  /* Timeline */
  .timeline {
    position: relative;
    border-left: 2px solid var(--border);
    padding-left: 2rem;
    margin-left: 1rem;
  }

  .timeline-item {
    position: relative;
    margin-bottom: 3rem;
  }

  .timeline-item:last-child {
    margin-bottom: 0;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    /* Sit directly on the 2px border */
    left: calc(-2rem - 0.4rem + 1px);
    top: 0.4rem;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--surface);
    border: 2px solid var(--accent);
  }

  .timeline-date {
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 0.5rem;
    font-weight: 500;
  }

  .timeline-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
  }

  .timeline-subtitle {
    font-size: 0.95rem;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }

  .timeline-description {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .about-layout {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }
  }

  @media (max-width: 768px) {
    .section {
      padding: 5rem var(--page-pad);
    }

    .timeline {
      padding-left: 1.5rem;
      margin-left: 0.5rem;
    }

    .timeline-item::before {
      left: calc(-1.5rem - 0.4rem + 1px);
      width: 0.8rem;
      height: 0.8rem;
      top: 0.35rem;
    }
  }

  @media (max-width: 600px) {
    .skills-wrapper {
      gap: 0.5rem;
    }

    .skill-pill {
      font-size: 0.85rem;
      padding: 0.5rem 1rem;
    }
  }
</style>
