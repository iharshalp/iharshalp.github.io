---
---

<section id="work" class="section container">
  <div class="reveal">
    <div class="eyebrow">Selected Artifacts</div>
    <h2 class="section-title">Real projects, <i>shipped and maintained.</i></h2>
  </div>

  <div class="work-grid">
    <!-- Genora AI (Row 1 - Left) -->
    <a
      href="https://genoracore.com"
      target="_blank"
      rel="noopener noreferrer"
      class="card col-8 reveal delay-1"
    >
      <div class="card-tags">
        <span class="tag">Next.js 15</span>
        <span class="tag">React 19</span>
        <span class="tag">TypeScript</span>
        <span class="tag">Firebase</span>
        <span class="tag">TailwindCSS</span>
      </div>
      <div class="card-header">
        <h3 class="card-title">
          Genora AI <i>Suite</i>
        </h3>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="external-icon">
          <path d="M15 3h6v6"></path>
          <path d="M10 14 21 3"></path>
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        </svg>
      </div>
      <p class="card-desc">
        A premium, production-grade Next.js ecosystem featuring 8 advanced
        AI-powered tools—including GENxCode (developer suite in 40+ languages), Chat with PDF (document intelligence),
        Social Media Studio, SEO Generator, Resume Builder, and Math Solver. Powered by custom Firestore
        state-management for seamless real-time interactivity.
      </p>
      <div class="card-meta">
        <span class="meta-pill">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5">
            <rect width="7" height="7" x="3" y="3" rx="1"></rect>
            <rect width="7" height="7" x="14" y="3" rx="1"></rect>
            <rect width="7" height="7" x="14" y="14" rx="1"></rect>
            <rect width="7" height="7" x="3" y="14" rx="1"></rect>
          </svg>
          8 Native Tools
        </span>
        <span class="meta-pill">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5">
            <rect width="16" height="10" x="2" y="3" rx="2"></rect>
            <rect width="6" height="10" x="16" y="11" rx="2"></rect>
            <path d="M12 17h.01"></path>
          </svg>
          Fully Responsive
        </span>
      </div>
    </a>

    <!-- CheckSSLExpiry (Row 1 - Right) -->
    <a
      href="https://checksslexpiry.com"
      target="_blank"
      rel="noopener noreferrer"
      class="card col-4 reveal delay-2"
    >
      <div class="card-tags">
        <span class="tag">Astro</span>
        <span class="tag">TypeScript</span>
        <span class="tag">REST API</span>
        <span class="tag">MCP Server</span>
        <span class="tag">Security</span>
      </div>
      <div class="card-header">
        <h3 class="card-title">
          CheckSSL<i>Expiry</i>
        </h3>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="external-icon">
          <path d="M15 3h6v6"></path>
          <path d="M10 14 21 3"></path>
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        </svg>
      </div>
      <p class="card-desc">
        High-precision SSL/TLS certificate monitoring & security platform. Features instant trust-chain inspection, passwordless 24/7 advance email alerts, DNS CAA validation (RFC 8659), and an AI Model Context Protocol (MCP) server for Claude & Cursor.
      </p>
      <div class="card-meta">
        <span class="meta-pill">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          24/7 Automated Alerts
        </span>
        <span class="meta-pill">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5">
            <rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect>
            <rect x="9" y="9" width="6" height="6"></rect>
            <line x1="9" y1="1" x2="9" y2="4"></line>
            <line x1="15" y1="1" x2="15" y2="4"></line>
            <line x1="9" y1="20" x2="9" y2="23"></line>
            <line x1="15" y1="20" x2="15" y2="23"></line>
            <line x1="20" y1="9" x2="23" y2="9"></line>
            <line x1="20" y1="14" x2="23" y2="14"></line>
            <line x1="1" y1="9" x2="4" y2="9"></line>
            <line x1="1" y1="14" x2="4" y2="14"></line>
          </svg>
          MCP Server & API
        </span>
      </div>
    </a>

    <!-- Ancestriq (Row 2 - Left) -->
    <article class="card col-4 reveal delay-1 center-content">
      <div class="badge-icon-wrapper">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 text-accent">
          <path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96-.44 2.5 2.5 0 0 1 0-3.12 3 3 0 0 1 0-3.88 2.5 2.5 0 0 1 0-3.12A2.5 2.5 0 0 1 9.5 2Z"/>
          <path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96-.44 2.5 2.5 0 0 0 0-3.12 3 3 0 0 0 0-3.88 2.5 2.5 0 0 0 0-3.12A2.5 2.5 0 0 0 14.5 2Z"/>
        </svg>
      </div>
      <h3 class="card-title">Ancestriq</h3>
      <p class="card-desc text-center">
        AI-powered ancestry story generator crafting unique, personalized family narratives with rich historical context.
      </p>
      <div class="card-tags mt-auto">
        <span class="tag">GenAI</span>
        <span class="tag">Storytelling</span>
      </div>
    </article>

    <!-- hOs Web OS (Row 2 - Right) -->
    <a
      href="https://os.hpatil.com"
      target="_blank"
      rel="noopener noreferrer"
      class="card col-8 reveal delay-2"
    >
      <div class="card-tags">
        <span class="tag">Vanilla JS</span>
        <span class="tag">GSAP 3</span>
        <span class="tag">HTML5 Canvas</span>
        <span class="tag">System Architecture</span>
        <span class="tag">Glassmorphism</span>
      </div>
      <div class="card-header">
        <h3 class="card-title">
          hOs <i>Web OS</i>
        </h3>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="external-icon">
          <path d="M15 3h6v6"></path>
          <path d="M10 14 21 3"></path>
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        </svg>
      </div>
      <p class="card-desc">
        A fully interactive, desktop operating system portfolio inspired by macOS and NeXTSTEP. Built with a custom window management engine, draggable & resizable windows with spring physics, interactive Dock, Launchpad, Spotlight Search, functional apps (Terminal, Notes, Calculator, Music Player), focus timer widget, and dynamic Canvas wallpapers.
      </p>
      <div class="card-meta">
        <span class="meta-pill">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5">
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="M6 8h.01"></path>
            <path d="M10 8h.01"></path>
            <path d="M14 8h.01"></path>
          </svg>
          Desktop Window Manager
        </span>
        <span class="meta-pill">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5">
            <rect width="7" height="7" x="3" y="3" rx="1"></rect>
            <rect width="7" height="7" x="14" y="3" rx="1"></rect>
            <rect width="7" height="7" x="14" y="14" rx="1"></rect>
            <rect width="7" height="7" x="3" y="14" rx="1"></rect>
          </svg>
          10+ Functional Apps
        </span>
      </div>
    </a>

    <!-- TryWebhook (Row 3 - Left) -->
    <a
      href="https://trywebhook.com"
      target="_blank"
      rel="noopener noreferrer"
      class="card col-8 reveal delay-1"
    >
      <div class="card-tags">
        <span class="tag">TypeScript</span>
        <span class="tag">Astro</span>
        <span class="tag">Preact Signals</span>
        <span class="tag">Cloudflare Workers</span>
        <span class="tag">Durable Objects (SQLite)</span>
        <span class="tag">WebSockets</span>
        <span class="tag">WebCrypto API</span>
      </div>
      <div class="card-header">
        <h3 class="card-title">
          TryWebhook <i>Platform</i>
        </h3>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="external-icon">
          <path d="M15 3h6v6"></path>
          <path d="M10 14 21 3"></path>
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        </svg>
      </div>
      <p class="card-desc">
        High-performance, edge-native webhook inspection platform that captures, debugs, and replays HTTP events in real time with byte-exact payload fidelity. Built with WebSocket streaming backed by SQLite Durable Objects, client-side cryptographic verification (HMAC-SHA256 &amp; Ed25519 via WebCrypto) with zero server-side secret persistence, configurable mock responses, and HAR 1.2/JSON export.
      </p>
      <div class="card-meta">
        <span class="meta-pill">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
          </svg>
          Real-Time WebSockets
        </span>
        <span class="meta-pill">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5">
            <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
            <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
          </svg>
          SQLite Durable Objects
        </span>
        <span class="meta-pill">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          Zero-Secret Persistence
        </span>
      </div>
    </a>

    <!-- AWS Deployment (Row 3 - Right) -->
    <article class="card col-4 reveal delay-2">
      <div class="card-tags">
        <span class="tag">EC2</span>
        <span class="tag">S3</span>
        <span class="tag">CloudFront</span>
        <span class="tag">RDS</span>
      </div>
      <h3 class="card-title">AWS Cloud Architecture</h3>
      <p class="card-desc">
        End-to-end production-grade cloud deployment — EC2, RDS, Route53, S3, CloudFront CDN, and ACM SSL.
      </p>
      <div class="card-tags mt-auto">
        <span class="tag">Infrastructure</span>
        <span class="tag">DevOps</span>
      </div>
    </article>

    <!-- SellerPhotoKit (Row 4 - Left) -->
    <a
      href="https://sellerphotokit.com"
      target="_blank"
      rel="noopener noreferrer"
      class="card col-6 reveal delay-1"
    >
      <div class="card-tags">
        <span class="tag">Preact</span>
        <span class="tag">WebAssembly</span>
        <span class="tag">Canvas API</span>
        <span class="tag">Client-Side</span>
        <span class="tag">TailwindCSS</span>
      </div>
      <div class="card-header">
        <h3 class="card-title">
          SellerPhotoKit <i>Suite</i>
        </h3>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="external-icon">
          <path d="M15 3h6v6"></path>
          <path d="M10 14 21 3"></path>
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        </svg>
      </div>
      <p class="card-desc">
        Privacy-first, client-side batch listing photo resizer & optimization suite for marketplace sellers (Poshmark, Depop, Vinted, Mercari, eBay, Etsy). Automatically decodes iPhone HEIC photos, strips sensitive EXIF & GPS data, whitens backdrops, and compresses files in-browser with zero server uploads.
      </p>
      <div class="card-meta">
        <span class="meta-pill">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
            <circle cx="8.5" cy="8.5" r="1.5"/>
            <polyline points="21 15 16 10 5 21"/>
          </svg>
          6 Marketplace Presets
        </span>
        <span class="meta-pill">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          100% In-Browser Privacy
        </span>
      </div>
    </a>

    <!-- UptimeCove (Row 4 - Right) -->
    <article class="card col-6 reveal delay-2">
      <div class="card-tags">
        <span class="tag">Open Source</span>
        <span class="tag">Astro</span>
        <span class="tag">Cloudflare Workers</span>
        <span class="tag">D1 Database</span>
        <span class="tag">TypeScript</span>
        <span class="tag">TailwindCSS</span>
      </div>
      <div class="card-header">
        <h3 class="card-title">
          <a href="https://uptimecove.com" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">
            UptimeCove <i>Monitor</i>
          </a>
        </h3>
        <div class="flex items-center gap-2.5 shrink-0">
          <a
            href="https://github.com/iharshalp/UptimeCove"
            target="_blank"
            rel="noopener noreferrer"
            class="action-btn"
            title="View Source on GitHub"
            aria-label="GitHub Repository"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
          </a>
          <a
            href="https://uptimecove.com"
            target="_blank"
            rel="noopener noreferrer"
            class="action-btn"
            title="Visit Live Site"
            aria-label="Visit Live Site"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="external-icon" style="margin-top:0;">
              <path d="M15 3h6v6"></path>
              <path d="M10 14 21 3"></path>
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            </svg>
          </a>
        </div>
      </div>
      <p class="card-desc">
        Open-source, edge-native uptime monitoring and public status page platform running entirely on serverless Cloudflare Workers and D1 database. Features per-minute health checks, automated incident tracking, response latency metrics, and zero-cost infrastructure.
      </p>
      <div class="card-meta">
        <a
          href="https://github.com/iharshalp/UptimeCove"
          target="_blank"
          rel="noopener noreferrer"
          class="meta-pill meta-link font-medium"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          GitHub: iharshalp/UptimeCove
        </a>
        <span class="meta-pill">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5">
            <path d="M13 2L4.5 12.5H11l-1 8.5L19.5 10H12l1-8z"></path>
          </svg>
          Edge-Native Serverless
        </span>
        <span class="meta-pill">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5">
            <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
            <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
          </svg>
          D1 & KV Database
        </span>
      </div>
    </article>

    <!-- Cielsko Websites (Row 5 - Left) -->
    <article class="card col-6 reveal delay-1">
      <div class="card-tags">
        <span class="tag">WordPress</span>
        <span class="tag">E-commerce</span>
        <span class="tag">UI/UX</span>
      </div>
      <h3 class="card-title">Cielsko Websites</h3>
      <p class="card-desc">
        E-commerce platforms for Cielsko Ecommerce LLP — product catalogs, UI design, payment integration, and custom WordPress solutions.
      </p>
      <div class="card-tags mt-auto">
        <span class="tag">E-commerce</span>
        <span class="tag">Web Dev</span>
      </div>
    </article>

    <!-- Freelance & Contract (Row 5 - Right) -->
    <article class="card col-6 reveal delay-2">
      <div class="card-tags">
        <span class="tag">Full Stack</span>
        <span class="tag">Cloud</span>
        <span class="tag">Mobile</span>
      </div>
      <h3 class="card-title">Freelance & Contract</h3>
      <p class="card-desc">
        Active contract engineering — web applications, custom API development, mobile apps, and cloud deployments for diverse clients.
      </p>
      <div class="card-tags mt-auto">
        <span class="tag">Client Solutions</span>
        <span class="tag">Consulting</span>
      </div>
    </article>
  </div>
</section>

<style>
  .container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--page-pad);
  }

  .section {
    padding: 8rem var(--page-pad);
  }

  .eyebrow {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--muted);
    margin-bottom: 1.5rem;
    font-weight: 600;
  }

  .section-title {
    font-size: clamp(2.25rem, 8vw, 4.5rem);
    margin-bottom: 1.5rem;
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .card {
    background: var(--surface);
    border-radius: var(--radius-md);
    padding: clamp(1.5rem, 2.5vw, 2.25rem);
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
    min-width: 0;
  }

  .card.center-content {
