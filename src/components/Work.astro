---
---

<section id="work" class="section container">
  <div class="reveal">
    <div class="eyebrow">Selected Artifacts</div>
    <h2 class="section-title">Real projects, <i>shipped and maintained.</i></h2>
  </div>

  <div class="work-grid">
    <!-- Genora AI -->
    <a
      href="https://genoracore.com"
      target="_blank"
      rel="noopener noreferrer"
      class="card col-8 reveal delay-1"
    >
      <div class="card-tags">
        <span class="tag">Next.js 15</span>
        <span class="tag">React 19</span>
        <span class="tag">TypeScript</span>
        <span class="tag">Firebase</span>
        <span class="tag">TailwindCSS</span>
      </div>
      <div class="flex justify-between items-start gap-4 w-full">
        <h3 class="mb-2 flex items-center gap-2">
          Genora AI <i>Suite</i>
        </h3>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-accent pt-0.5">
          <path d="M15 3h6v6"></path>
          <path d="M10 14 21 3"></path>
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        </svg>
      </div>
      <p class="mb-6">
        A premium, production-grade Next.js ecosystem featuring 8 advanced
        AI-powered tools—including GENxCode (developer suite in 40+ languages), Chat with PDF (document intelligence),
        Social Media Studio, SEO Generator, Resume Builder, and Math Solver. Powered by custom Firestore
        state-management for seamless real-time interactivity.
      </p>
      <div class="card-meta">
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5">
            <rect width="7" height="7" x="3" y="3" rx="1"></rect>
            <rect width="7" height="7" x="14" y="3" rx="1"></rect>
            <rect width="7" height="7" x="14" y="14" rx="1"></rect>
            <rect width="7" height="7" x="3" y="14" rx="1"></rect>
          </svg>
          8 Native Tools
        </span>
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5">
            <rect width="16" height="10" x="2" y="3" rx="2"></rect>
            <rect width="6" height="10" x="16" y="11" rx="2"></rect>
            <path d="M12 17h.01"></path>
          </svg>
          Fully Responsive
        </span>
      </div>
    </a>

    <!-- BugToBuild -->
    <article class="card col-4 reveal delay-2" style="border-top: 4px solid var(--accent);">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10 text-accent mb-4">
        <path d="M12 20h9"></path>
        <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
      </svg>
      <h3>BugToBuild</h3>
      <p class="mb-8">
        Comprehensive developer blog — step-by-step guides, code snippets, and visual
        walkthroughs on Firebase, AI & productivity.
      </p>
      <div class="card-tags mt-auto">
        <span class="tag">Technical Writing</span>
        <span class="tag">SEO</span>
      </div>
    </article>

    <!-- Ancestriq -->
    <article class="card col-4 reveal delay-1 center-content">
      <div class="badge-icon-wrapper">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 text-accent">
          <path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96-.44 2.5 2.5 0 0 1 0-3.12 3 3 0 0 1 0-3.88 2.5 2.5 0 0 1 0-3.12A2.5 2.5 0 0 1 9.5 2Z"/>
          <path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96-.44 2.5 2.5 0 0 0 0-3.12 3 3 0 0 0 0-3.88 2.5 2.5 0 0 0 0-3.12A2.5 2.5 0 0 0 14.5 2Z"/>
        </svg>
      </div>
      <h3 class="mb-2">Ancestriq</h3>
      <p class="text-[0.95rem]">
        AI-powered ancestry story generator crafting unique, personalized family narratives.
      </p>
    </article>

    <!-- AWS Deployment -->
    <article class="card col-8 reveal delay-2">
      <div class="card-tags">
        <span class="tag">EC2</span>
        <span class="tag">S3</span>
        <span class="tag">CloudFront</span>
        <span class="tag">RDS</span>
      </div>
      <h3>AWS Cloud Architecture</h3>
      <p>
        End-to-end production-grade cloud deployment — EC2, RDS, Route53, S3, CloudFront CDN, and ACM SSL.
      </p>
    </article>

    <!-- Cielsko & Freelance -->
    <article class="card col-6 reveal delay-1">
      <h3>Cielsko Websites</h3>
      <p>
        E-commerce sites for Cielsko Ecommerce LLP — product management, UI design, and WordPress solutions.
      </p>
      <div class="card-tags mt-auto pt-6">
        <span class="tag">WordPress</span>
        <span class="tag">E-commerce</span>
      </div>
    </article>

    <article class="card col-6 reveal delay-2">
      <h3>Freelance & Contract</h3>
      <p>
        Active contract work — web development, app development, and cloud deployments for various clients.
      </p>
      <div class="card-tags mt-auto pt-6">
        <span class="tag">Full Stack</span>
        <span class="tag">Cloud</span>
        <span class="tag">Mobile</span>
      </div>
    </article>
  </div>
</section>

<style>
  .container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--page-pad);
  }

  .section {
    padding: 8rem var(--page-pad);
  }

  .eyebrow {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--muted);
    margin-bottom: 1.5rem;
    font-weight: 600;
  }

  .section-title {
    font-size: clamp(2.25rem, 8vw, 4.5rem);
    margin-bottom: 1.5rem;
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .card {
    background: var(--surface);
    border-radius: var(--radius-md);
    padding: 2.5rem;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  .card.center-content {
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-md);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, white 40%, transparent);
    pointer-events: none;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px -15px color-mix(in srgb, var(--fg) 10%, transparent);
  }

  .card-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .card-tags.mt-auto {
    margin-top: auto;
    margin-bottom: 0;
  }

  .tag {
    background: var(--bg);
    border: 1px solid var(--border);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.75rem;
    text-transform: lowercase;
    color: var(--muted);
  }

  .card h3 {
    font-size: clamp(1.5rem, 4vw, 2rem);
    margin-bottom: 1rem;
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .card p {
    color: var(--muted);
    font-size: 1rem;
  }

  .card-meta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: auto;
    font-size: 0.8rem;
    color: var(--muted);
    border-top: 1px solid var(--border);
    padding-top: 1rem;
    width: 100%;
  }

  .badge-icon-wrapper {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  /* Bento Spans */
  .col-8 {
    grid-column: span 8;
  }

  .col-4 {
    grid-column: span 4;
  }

  .col-6 {
    grid-column: span 6;
  }

  @media (max-width: 900px) {
    .col-8,
    .col-4,
    .col-6 {
      grid-column: span 12;
    }
  }

  @media (max-width: 768px) {
    .section {
      padding: 5rem var(--page-pad);
    }

    .card {
      padding: 1.5rem;
    }
  }
</style>
