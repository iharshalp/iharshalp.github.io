  .copyright {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .footer-links {
    display: flex;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .footer-links a {
    color: var(--muted);
    font-size: 0.95rem;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .footer-links a:hover {
    color: var(--fg);
  }
