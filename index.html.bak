<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Harshal Patil | Full Stack Developer & AI Enthusiast</title>
  <meta name="description"
    content="Portfolio of Harshal Patil — Full Stack Developer & AI Enthusiast crafting stunning digital experiences.">
  <link rel="icon" type="image/png" href="fav.png">
  <link rel="apple-touch-icon" href="fav.png">
  <meta property="og:title" content="Harshal Patil | Full Stack Developer & AI Enthusiast">
  <meta property="og:description"
    content="Portfolio of Harshal Patil — Full Stack Developer & AI Enthusiast crafting stunning digital experiences.">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="Harshal Patil | Full Stack Developer & AI Enthusiast">
  <meta name="twitter:description" content="Portfolio of Harshal Patil — crafting stunning digital experiences.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&display=swap"
    rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    rel="stylesheet" />

  <style>
    :root {
      /* Palette */
      --bg: oklch(97% 0.018 70);
      --surface: oklch(99% 0.008 70);
      --fg: oklch(22% 0.02 50);
      --muted: oklch(50% 0.018 50);
      --border: oklch(90% 0.014 70);
      --accent: oklch(64% 0.13 28);
      --error: #e74c3c;
      --success: #27ae60;

      /* Typography */
      --font-display: 'Newsreader', 'Tiempos Headline', Georgia, serif;
      --font-body: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;

      /* Radii */
      --radius-sm: 8px;
      --radius-md: 16px;
      --radius-lg: 24px;

      /* Global Layout Padding - Dynamically guarantees edge space */
      --page-pad: clamp(1.5rem, 6vw, 3rem);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: var(--bg);
      color: var(--fg);
      font-family: var(--font-body);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
    }

    h1,
    h2,
    h3,
    h4 {
      font-family: var(--font-display);
      font-weight: 400;
      line-height: 1.1;
      letter-spacing: -0.02em;
      overflow-wrap: break-word;
      /* Prevents text from forcing horizontal scroll */
    }

    h1 i,
    h2 i,
    h3 i {
      font-style: italic;
      color: var(--accent);
    }

    a {
      text-decoration: none;
      color: inherit;
      transition: color 0.3s ease;
    }

    img {
      max-width: 100%;
      display: block;
    }

    /* Layout & Utilities */
    .container {
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 var(--page-pad);
    }

    .section {
      padding: 8rem var(--page-pad);
    }

    .eyebrow {
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--muted);
      margin-bottom: 1.5rem;
      font-weight: 600;
    }

    /* Typography Classes */
    .section-title {
      font-size: clamp(2.25rem, 8vw, 4.5rem);
      margin-bottom: 1.5rem;
    }

    .section-title.large {
      font-size: clamp(2.75rem, 10vw, 6rem);
      margin-bottom: 1rem;
    }

    .lead-text {
      font-size: clamp(1.05rem, 2.5vw, 1.15rem);
      margin-bottom: 1.5rem;
    }

    .lead-text.fg {
      color: var(--fg);
    }

    .lead-text.muted {
      color: var(--muted);
    }

    /* Animations */
    .reveal {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1), transform 1s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .reveal.in-view {
      opacity: 1;
      transform: translateY(0);
    }

    .delay-1 {
      transition-delay: 0.1s;
    }

    .delay-2 {
      transition-delay: 0.2s;
    }

    .delay-3 {
      transition-delay: 0.3s;
    }

    /* Navigation */
    nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      padding: 1.5rem var(--page-pad);
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 100;
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      background: color-mix(in srgb, var(--bg) 80%, transparent);
      border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
    }

    .nav-logo {
      font-family: var(--font-display);
      font-size: 1.5rem;
      font-style: italic;
      font-weight: 600;
    }

    .nav-links {
      display: flex;
      gap: 2.5rem;
      font-size: 0.95rem;
    }

    .nav-links a {
      color: var(--muted);
    }

    .nav-links a:hover,
    .nav-links a.active {
      color: var(--fg);
    }

    .nav-cta {
      background: var(--accent);
      color: white;
      padding: 0.6rem 1.25rem;
      border-radius: 999px;
      font-size: 0.9rem;
      font-weight: 500;
      transition: transform 0.3s ease, background 0.3s ease;
      white-space: nowrap;
    }

    .nav-cta:hover {
      transform: scale(1.05);
      background: color-mix(in srgb, var(--accent) 85%, black);
    }


    /* Hero Section */
    .hero {
      min-height: 100vh;
      min-height: 100dvh;
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      align-items: center;
      gap: 4rem;
      padding-top: 6rem;
      position: relative;
    }

    .hero-title {
      font-size: clamp(3.25rem, 11vw, 8rem);
      margin-bottom: 1.5rem;
      max-width: 1000px;
    }

    .hero-subtitle {
      font-size: clamp(1.1rem, 3vw, 1.5rem);
      color: var(--muted);
      max-width: 700px;
      line-height: 1.5;
    }

    /* Code-Driven Hero Visual (Desktop Only) */
    .hero-visual {
      position: relative;
      width: 100%;
      height: 100%;
      min-height: 400px;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .sculpture-container {
      position: relative;
      width: 320px;
      height: 320px;
      perspective: 1000px;
    }

    .orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(35px);
      opacity: 0.6;
      animation: floatOrb 8s ease-in-out infinite alternate;
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: transform;
    }

    .orb-accent {
      background: var(--accent);
      width: 220px;
      height: 220px;
      top: -10%;
      left: -10%;
      animation-delay: 0s;
    }

    .orb-muted {
      background: color-mix(in srgb, var(--fg) 50%, var(--surface));
      width: 180px;
      height: 180px;
      bottom: -5%;
      right: -5%;
      animation-delay: -4s;
      animation-direction: alternate-reverse;
    }

    @keyframes floatOrb {
      0% {
        translate: 0 0;
        scale: 1;
      }

      100% {
        translate: 30px -30px;
        scale: 1.15;
      }
    }

    .glass-core {
      position: absolute;
      inset: 20px;
      border-radius: 50%;
      border: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
      background: color-mix(in srgb, var(--surface) 30%, transparent);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 32px 64px -16px color-mix(in srgb, var(--fg) 12%, transparent),
        inset 0 0 20px color-mix(in srgb, white 40%, transparent);
      z-index: 2;
      transform-style: preserve-3d;
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: transform;
    }

    .core-svg {
      width: 75%;
      height: 75%;
      color: var(--accent);
      overflow: visible;
    }

    .spin-slow {
      transform-origin: 100px 100px;
      animation: spin 20s linear infinite;
    }

    .spin-reverse {
      transform-origin: 100px 100px;
      animation: spin 25s linear infinite reverse;
    }

    .pulse-stroke {
      animation: pulseOpacity 4s ease-in-out infinite;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    @keyframes pulseOpacity {

      0%,
      100% {
        opacity: 0.3;
        stroke-width: 0.5;
      }

      50% {
        opacity: 0.8;
        stroke-width: 1.5;
      }
    }

    .floating-badge {
      position: absolute;
      background: color-mix(in srgb, var(--surface) 85%, transparent);
      border: 1px solid var(--border);
      padding: 0.6rem 1.2rem;
      border-radius: 999px;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.8rem;
      font-weight: 500;
      color: var(--fg);
      box-shadow: 0 8px 24px -8px color-mix(in srgb, var(--fg) 10%, transparent);
      z-index: 3;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      animation: floatBadge 6s ease-in-out infinite;
      transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s;
      will-change: transform;
      white-space: nowrap;
    }

    .floating-badge .material-symbols-outlined {
      color: var(--accent);
      font-size: 1.1rem;
    }

    .badge-1 {
      top: 5%;
      left: -15%;
      animation-delay: 0s;
    }

    .badge-2 {
      bottom: 10%;
      right: -10%;
      animation-delay: 2s;
    }

    @keyframes floatBadge {

      0%,
      100% {
        translate: 0 0;
      }

      50% {
        translate: 0 -10px;
      }
    }

    /* Work Section (Bento Grid) */
    .work-grid {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 1.5rem;
      margin-top: 3rem;
    }

    .card {
      background: var(--surface);
      border-radius: var(--radius-md);
      padding: 2.5rem;
      position: relative;
      overflow: hidden;
      border: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      transition: transform 0.4s ease, box-shadow 0.4s ease;
    }

    .card.center-content {
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .card::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: var(--radius-md);
      box-shadow: inset 0 0 0 1px color-mix(in srgb, white 40%, transparent);
      pointer-events: none;
    }

    .card:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 40px -15px color-mix(in srgb, var(--fg) 10%, transparent);
    }

    .card-tags {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-bottom: 1.5rem;
    }

    .card-tags.mt-auto {
      margin-top: auto;
      margin-bottom: 0;
    }

    .tag {
      background: var(--bg);
      border: 1px solid var(--border);
      padding: 0.35rem 0.85rem;
      border-radius: 999px;
      font-size: 0.75rem;
      text-transform: lowercase;
      color: var(--muted);
    }

    .card h3 {
      font-size: clamp(1.5rem, 4vw, 2rem);
      margin-bottom: 1rem;
    }

    .card p {
      color: var(--muted);
      font-size: 1rem;
    }

    .card-icon {
      font-size: 2.5rem;
      color: var(--accent);
      margin-bottom: 1rem;
    }

    /* Bento Spans */
    .col-8 {
      grid-column: span 8;
    }

    .col-4 {
      grid-column: span 4;
    }

    .col-6 {
      grid-column: span 6;
    }

    /* About & Experience */
    .about-layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }

    .timeline {
      position: relative;
      border-left: 2px solid var(--border);
      padding-left: 2rem;
      margin-left: 1rem;
    }

    .timeline-item {
      position: relative;
      margin-bottom: 3rem;
    }

    .timeline-item:last-child {
      margin-bottom: 0;
    }

    .timeline-item::before {
      content: '';
      position: absolute;
      /* Precisely math'ed to sit directly on the 2px border */
      left: calc(-2rem - 0.4rem + 1px);
      top: 0.4rem;
      width: 0.8rem;
      height: 0.8rem;
      border-radius: 50%;
      background: var(--surface);
      border: 2px solid var(--accent);
    }

    .timeline-date {
      font-size: 0.85rem;
      color: var(--muted);
      margin-bottom: 0.5rem;
      font-weight: 500;
    }

    .timeline-title {
      font-family: var(--font-display);
      font-size: 1.5rem;
      margin-bottom: 0.25rem;
    }

    .timeline-subtitle {
      font-size: 0.95rem;
      color: var(--muted);
      margin-bottom: 0.75rem;
    }

    /* Skills */
    .skills-wrapper {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: 2rem;
    }

    .skill-pill {
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 0.6rem 1.2rem;
      border-radius: 999px;
      font-size: 0.9rem;
      color: var(--fg);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .skill-pill .material-symbols-outlined {
      font-size: 1.1rem;
      color: var(--accent);
    }

    /* Contact Form Section */
    .contact-section {
      background: var(--surface);
      border-top: 1px solid var(--border);
    }

    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
    }

    .form-wrapper {
      background: var(--bg);
      padding: 3rem;
      border-radius: var(--radius-lg);
      border: 1px solid var(--border);
    }

    .contact-form {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }

    .form-row>div {
      display: flex;
      flex-direction: column;
    }

    .contact-form input,
    .contact-form textarea {
      width: 100%;
      padding: 1rem 1.25rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      color: var(--fg);
      font-family: var(--font-body);
      font-size: 0.95rem;
      outline: none;
      transition: border-color 0.3s, box-shadow 0.3s;
      appearance: none;
    }

    .contact-form input::placeholder,
    .contact-form textarea::placeholder {
      color: var(--muted);
    }

    .contact-form input:focus,
    .contact-form textarea:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 15%, transparent);
    }

    .contact-form textarea {
      min-height: 140px;
      resize: vertical;
    }

    .submit-btn {
      background: var(--accent);
      color: white;
      border: none;
      padding: 1rem 2rem;
      border-radius: 999px;
      font-size: 1rem;
      font-weight: 500;
      cursor: pointer;
      transition: transform 0.3s, background 0.3s;
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 0.5rem;
    }

    .submit-btn:hover {
      transform: translateY(-2px);
      background: color-mix(in srgb, var(--accent) 85%, black);
    }

    .submit-btn:disabled {
      opacity: 0.7;
      cursor: not-allowed;
      transform: none;
    }

    /* Footer */
    footer {
      padding: 4rem var(--page-pad);
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      border-top: 1px solid var(--border);
    }

    .footer-brand {
      font-family: var(--font-display);
      font-size: 2rem;
      margin-bottom: 0.5rem;
      font-style: italic;
    }

    .footer-links {
      display: flex;
      gap: 2rem;
      margin-top: 1.5rem;
    }

    /* Toast */
    .toast {
      position: fixed;
      bottom: 2rem;
      left: 50%;
      transform: translate(-50%, 100px);
      background: var(--fg);
      color: var(--bg);
      padding: 1rem 2rem;
      border-radius: 999px;
      font-size: 0.95rem;
      font-weight: 500;
      opacity: 0;
      z-index: 1000;
      transition: opacity 0.4s, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .toast.show {
      opacity: 1;
      transform: translate(-50%, 0);
    }

    .toast.error {
      background: var(--error);
    }

    .toast.success {
      background: var(--success);
    }

    /* Accessibility */
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .skip-link {
      position: fixed;
      top: -100%;
      left: 1rem;
      background: var(--accent);
      color: white;
      padding: 0.75rem 1.5rem;
      border-radius: 0 0 var(--radius-sm) var(--radius-sm);
      z-index: 200;
      font-weight: 500;
      transition: top 0.3s;
    }

    .skip-link:focus {
      top: 0;
    }

    /* =========================================
       RESPONSIVE BREAKPOINTS
       ========================================= */

    @media (max-width: 1000px) {
      .hero {
        grid-template-columns: 1fr;
        padding-top: 8rem;
      }

      .hero-visual {
        display: none;
      }
    }

    @media (max-width: 900px) {

      .col-8,
      .col-4,
      .col-6 {
        grid-column: span 12;
      }

      .about-layout,
      .contact-grid {
        grid-template-columns: 1fr;
        gap: 2.5rem;
      }
    }

    @media (max-width: 768px) {
      :root {
        --page-pad: 1.5rem;
      }

      nav {
        padding: 1rem var(--page-pad);
      }

      .nav-links {
        display: none;
      }

      .section {
        padding: 5rem var(--page-pad);
      }

      .card {
        padding: 1.5rem;
      }

      .form-wrapper {
        padding: 1.5rem;
      }

      .timeline {
        padding-left: 1.5rem;
        margin-left: 0.5rem;
      }

      .timeline-item::before {
        left: calc(-1.5rem - 0.4rem + 1px);
        width: 0.8rem;
        height: 0.8rem;
        top: 0.35rem;
      }
    }

    @media (max-width: 600px) {
      .form-row {
        grid-template-columns: 1fr;
      }

      .skills-wrapper {
        gap: 0.5rem;
      }

      .skill-pill {
        font-size: 0.85rem;
        padding: 0.5rem 1rem;
      }
    }
  </style>
</head>

<body>

  <a href="#main-content" class="skip-link">Skip to main content</a>

  <nav aria-label="Main navigation">
    <div class="nav-logo">Harshal Patil</div>
    <div class="nav-links">
      <a href="#work" class="nav-item">Work</a>
      <a href="#about" class="nav-item">About</a>
      <a href="#contact" class="nav-item">Contact</a>
    </div>
    <a href="#contact" class="nav-cta">Hire Me</a>
  </nav>

  <main id="main-content">
    <!-- Hero -->
    <section class="hero container">
      <div class="hero-text reveal">
        <div class="eyebrow">Full Stack Developer & AI Enthusiast</div>
        <h1 class="hero-title">
          Harshal <br><i>Patil</i>
        </h1>
        <p class="hero-subtitle">
          Building real-world web applications, AI-powered tools, and cloud infrastructure that solve actual problems.
        </p>
      </div>

      <!-- Code-driven kinetic visual -->
      <div class="hero-visual reveal delay-2">
        <div class="sculpture-container">
          <div class="orb orb-accent"></div>
          <div class="orb orb-muted"></div>

          <div class="glass-core">
            <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" class="core-svg">
              <g class="spin-slow" stroke="currentColor" fill="none">
                <circle cx="100" cy="100" r="85" stroke-width="0.5" stroke-dasharray="2 4" opacity="0.5" />
                <ellipse cx="100" cy="100" rx="85" ry="25" stroke-width="1" class="pulse-stroke" />
                <ellipse cx="100" cy="100" rx="25" ry="85" stroke-width="1" class="pulse-stroke"
                  style="animation-delay: -2s;" />
              </g>
              <g class="spin-reverse" stroke="currentColor" fill="none">
                <circle cx="100" cy="100" r="50" stroke-width="1" opacity="0.6" />
                <polygon points="100,50 143,125 57,125" stroke-width="0.5" opacity="0.4" />
                <polygon points="100,150 57,75 143,75" stroke-width="0.5" opacity="0.4" />
              </g>
              <circle cx="100" cy="100" r="6" fill="currentColor" opacity="0.8" />
            </svg>
          </div>

          <div class="floating-badge badge-1">
            <span class="material-symbols-outlined">psychology</span>
            <span>AI Architect</span>
          </div>
          <div class="floating-badge badge-2">
            <span class="material-symbols-outlined">data_object</span>
            <span>System Design</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Work -->
    <section id="work" class="section container">
      <div class="reveal">
        <div class="eyebrow">Selected Artifacts</div>
        <h2 class="section-title">Real projects, <i>shipped and maintained.</i></h2>
      </div>

      <div class="work-grid">

        <!-- Genora AI -->
        <a href="https://genoracore.com" target="_blank" rel="noopener noreferrer" class="card col-8 reveal delay-1"
          style="text-decoration: none; color: inherit; display: flex; flex-direction: column;">
